MYSQL_USER=root
MYSQL_PASSWORD=CHANGEME

PROD_DB_PASSWORD=CHANGEME
NEXTCLOUD_DB_PASSWORD=CHANGEME

GOTIFY_URL=https://gotify.example.com/message
GOTIFY_TOKEN=CHANGEME

GOTIFY_PRIORITY_SUCCESS=4
GOTIFY_PRIORITY_ERROR=8

RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# Bulk-Repository: nimmt den kompletten Satz auf, braucht also viel Platz.
RESTIC_REPOSITORY=rclone:hetzner:bucket/docker-restic

# Kleines, verlaessliches Repository nur fuer den unverzichtbaren Satz
# (Vaultwarden, DB-Dumps, Container-Konfigurationen). Ohne diesen Eintrag
# wird der Schritt uebersprungen - der Lauf meldet das, sichert den
# kritischen Satz dann aber NUR im Bulk-Repository.
#
# Einmalig anlegen, bevor der Eintrag hier gesetzt wird:
#   restic -r rclone:1blu:restic-critical init
RESTIC_REPOSITORY_CRITICAL=rclone:1blu:restic-critical

# Gilt fuer beide Repositories.
RESTIC_PASSWORD='YourResticPassword'

# Standard-Wiederherstellungspfad (optional)
# RESTORE_DEFAULT_PATH=./restore-out